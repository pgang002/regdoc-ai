__pycache__/
*.py[cod]
.venv/
.env
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Derived and large data
/data/interim/**
!/data/interim/.gitkeep
/data/processed/**
!/data/processed/.gitkeep
/data/raw/pubtables/**
!/data/raw/pubtables/README.md
/data/raw/clinicaltrials/*.json
/data/raw/clinicaltrials/*.csv
/results/**
!/results/README.md

# Model files
*.pt
*.pth
*.onnx
*.safetensors

