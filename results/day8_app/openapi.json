{
  "openapi": "3.1.0",
  "info": {
    "title": "RegDocAI API",
    "description": "Synchronous Day 8 API for regulatory document classification, extraction, table reconstruction, and policy-driven redaction.",
    "version": "0.8.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/model-info": {
      "get": {
        "summary": "Model Info",
        "operationId": "model_info_model_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Model Info Model Info Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documents/process": {
      "post": {
        "summary": "Process Document",
        "operationId": "process_document_v1_documents_process_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_process_document_v1_documents_process_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessingResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documents/{document_id}": {
      "get": {
        "summary": "Get Document",
        "operationId": "get_document_v1_documents__document_id__get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessingResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documents/{document_id}/redactions/apply": {
      "post": {
        "summary": "Apply Redactions",
        "operationId": "apply_redactions_v1_documents__document_id__redactions_apply_post",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyRedactionsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyRedactionsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documents/{document_id}/artifacts/{artifact_name}": {
      "get": {
        "summary": "Download Artifact",
        "operationId": "download_artifact_v1_documents__document_id__artifacts__artifact_name__get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          },
          {
            "name": "artifact_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Artifact Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplyRedactionsRequest": {
        "properties": {
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/RedactionDecision"
            },
            "type": "array",
            "title": "Decisions"
          }
        },
        "type": "object",
        "title": "ApplyRedactionsRequest"
      },
      "ApplyRedactionsResponse": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "redacted_count": {
            "type": "integer",
            "title": "Redacted Count"
          },
          "review_count": {
            "type": "integer",
            "title": "Review Count"
          },
          "retained_count": {
            "type": "integer",
            "title": "Retained Count"
          },
          "ignored_count": {
            "type": "integer",
            "title": "Ignored Count"
          },
          "artifact": {
            "$ref": "#/components/schemas/ArtifactLink"
          },
          "audit_artifact": {
            "$ref": "#/components/schemas/ArtifactLink"
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "redacted_count",
          "review_count",
          "retained_count",
          "ignored_count",
          "artifact",
          "audit_artifact"
        ],
        "title": "ApplyRedactionsResponse"
      },
      "ArtifactLink": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Size Bytes"
          },
          "download_path": {
            "type": "string",
            "title": "Download Path"
          }
        },
        "type": "object",
        "required": [
          "name",
          "media_type",
          "size_bytes",
          "download_path"
        ],
        "title": "ArtifactLink"
      },
      "Body_process_document_v1_documents_process_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_process_document_v1_documents_process_post"
      },
      "BoundingBox": {
        "properties": {
          "x_min": {
            "type": "number",
            "title": "X Min"
          },
          "y_min": {
            "type": "number",
            "title": "Y Min"
          },
          "x_max": {
            "type": "number",
            "title": "X Max"
          },
          "y_max": {
            "type": "number",
            "title": "Y Max"
          }
        },
        "type": "object",
        "required": [
          "x_min",
          "y_min",
          "x_max",
          "y_max"
        ],
        "title": "BoundingBox"
      },
      "CheckboxResult": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "bounding_box": {
            "$ref": "#/components/schemas/BoundingBox"
          }
        },
        "type": "object",
        "required": [
          "name",
          "state",
          "page",
          "confidence",
          "bounding_box"
        ],
        "title": "CheckboxResult"
      },
      "ExtractedField": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "bounding_box": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BoundingBox"
              },
              {
                "type": "null"
              }
            ]
          },
          "extraction_method": {
            "type": "string",
            "title": "Extraction Method"
          }
        },
        "type": "object",
        "required": [
          "name",
          "value",
          "page",
          "confidence",
          "extraction_method"
        ],
        "title": "ExtractedField"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PageClassification": {
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "decision_source": {
            "type": "string",
            "title": "Decision Source"
          },
          "rule_reason": {
            "type": "string",
            "title": "Rule Reason"
          },
          "table_line_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Table Line Score"
          }
        },
        "type": "object",
        "required": [
          "page",
          "label",
          "confidence",
          "decision_source",
          "rule_reason",
          "table_line_score"
        ],
        "title": "PageClassification"
      },
      "ProcessingResponse": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "source_filename": {
            "type": "string",
            "title": "Source Filename"
          },
          "status": {
            "$ref": "#/components/schemas/ProcessingStatus"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "processing_seconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Processing Seconds"
          },
          "page_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Page Count"
          },
          "classifications": {
            "items": {
              "$ref": "#/components/schemas/PageClassification"
            },
            "type": "array",
            "title": "Classifications"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/ExtractedField"
            },
            "type": "array",
            "title": "Fields"
          },
          "checkboxes": {
            "items": {
              "$ref": "#/components/schemas/CheckboxResult"
            },
            "type": "array",
            "title": "Checkboxes"
          },
          "tables": {
            "items": {
              "$ref": "#/components/schemas/TableArtifact"
            },
            "type": "array",
            "title": "Tables"
          },
          "redaction_candidates": {
            "items": {
              "$ref": "#/components/schemas/RedactionCandidate"
            },
            "type": "array",
            "title": "Redaction Candidates"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactLink"
            },
            "type": "array",
            "title": "Artifacts"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "document_id",
          "source_filename",
          "status",
          "created_at",
          "page_count"
        ],
        "title": "ProcessingResponse"
      },
      "ProcessingStatus": {
        "type": "string",
        "enum": [
          "UPLOADED",
          "QUEUED",
          "PREPROCESSING",
          "OCR_RUNNING",
          "TABLE_EXTRACTION",
          "REDACTION",
          "VALIDATION",
          "COMPLETED",
          "FAILED",
          "NEEDS_REVIEW"
        ],
        "title": "ProcessingStatus"
      },
      "RedactionCandidate": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "title": "Candidate Id"
          },
          "entity_type": {
            "type": "string",
            "title": "Entity Type"
          },
          "action": {
            "type": "string",
            "enum": [
              "redact",
              "review",
              "retain",
              "ignore"
            ],
            "title": "Action"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "field_name": {
            "type": "string",
            "title": "Field Name"
          },
          "masked_text": {
            "type": "string",
            "title": "Masked Text"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "bounding_box": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Bounding Box"
          },
          "detection_methods": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Detection Methods"
          },
          "needs_review": {
            "type": "boolean",
            "title": "Needs Review",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "candidate_id",
          "entity_type",
          "action",
          "page",
          "field_name",
          "masked_text",
          "confidence",
          "bounding_box"
        ],
        "title": "RedactionCandidate"
      },
      "RedactionDecision": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "title": "Candidate Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "redact",
              "review",
              "retain",
              "ignore"
            ],
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "candidate_id",
          "action"
        ],
        "title": "RedactionDecision"
      },
      "TableArtifact": {
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "csv_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Csv Path"
          },
          "json_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Json Path"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "page"
        ],
        "title": "TableArtifact"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}